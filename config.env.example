# Caminhos opcionais (sem segredos). Copie para <pasta-da-skill>/config.env ou ~/.config/youtube-clips/config.env.
# Tudo tem padrão; só preencha o que quiser mudar.

# Onde ficam o venv e o modelo de rosto (padrão: ~/.local/share/youtube-clips)
# YOUTUBE_CLIPS_HOME=/opt/youtube-clips

# Arquivos .env de credenciais, além de ~/.config/youtube-clips/.env (vários separados por ":")
# YOUTUBE_CLIPS_SECRETS=/etc/minha-empresa/segredos.env

# Arquivo de cookies do YouTube (padrão: ~/.config/youtube-clips/youtube-cookies.txt)
# YOUTUBE_COOKIES=/caminho/youtube-cookies.txt
