# Credenciais da skill youtube-clips. Copie para ~/.config/youtube-clips/.env (o setup.sh faz isso)
# e preencha. Nunca versione o arquivo preenchido.

# Transcrição e tradução das legendas (obrigatória no modo padrão). https://console.groq.com/keys
GROQ_API_KEY=

# --- Download do YouTube a partir de servidor (VPS/nuvem): escolha UMA forma de proxy ---
# Webshare: chave de API (Dashboard > API Keys). O script lê o plano e as credenciais sozinho.
# Use plano Residential ou ISP (datacenter também é bloqueado pelo YouTube).
WEBSHARE_API_KEY=
# País preferido dos proxies (padrão US; no nosso teste os dos EUA passaram e FR/CA/DE não).
WEBSHARE_COUNTRY=
# Qualquer outro fornecedor de proxy residencial/ISP: http://usuario:senha@host:porta
YOUTUBE_PROXY_URL=

# --- Plano B opcional: Apify (pago), usado só se o yt-dlp continuar bloqueado ---
# https://console.apify.com/settings/integrations
APIFY_TOKEN=
